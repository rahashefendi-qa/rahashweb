# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (local) or add the same keys in your host's
# Environment Variables screen (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit your real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) — REQUIRED ─────────────────────────────────────────
# Local example:  postgresql://store:store@localhost:5432/store?schema=public
# Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL = the "Transaction pooler" URL (port 6543) + "?pgbouncer=true"
#   DIRECT_URL   = the "Session pooler" / direct URL (port 5432) — used for migrations
# Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ── Admin sessions — REQUIRED ────────────────────────────────────────────────
# A long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every admin out.
AUTH_SECRET=""

# ── Public site URL — REQUIRED in production ─────────────────────────────────
# Used for links in emails, the sitemap, and social previews. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email — REQUIRED for order notifications (choose ONE provider) ───────────
# Sender address. With Resend it must be on a domain you verified in Resend.
EMAIL_FROM="YOUR BRAND <orders@yourdomain.com>"

# Option A — Resend (recommended): https://resend.com → API Keys
RESEND_API_KEY=""

# Option B — any SMTP server (Gmail with an App Password, Zoho, Brevo, …)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"

# ── Image uploads — REQUIRED in production ───────────────────────────────────
# Cloudinary → Dashboard → "Product Environment Credentials"
# Without these, uploads are saved to ./uploads (works for local development only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional: top-level Cloudinary folder
# CLOUDINARY_FOLDER="store"

# ── Optional first-run defaults ─────────────────────────────────────────────
# Used ONLY to pre-fill Settings the very first time the store starts.
# After that, change everything in Admin → Settings.
# STORE_NAME="YOUR BRAND"
# ADMIN_EMAIL="you@example.com"        # receives new-order emails
# STORE_EMAIL="hello@yourdomain.com"   # shown publicly
# STORE_PHONE="+961 3 123 456"
# STORE_WHATSAPP="+961 3 123 456"
# WISH_MONEY_NUMBER="03 123 456"
# WISH_MONEY_NAME="Account holder name"
